# =============================================================================
# Instagram Auto Liker - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# Master encryption key — used to encrypt IG cookies/passwords at rest.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_KEY=replace-with-a-long-random-string

# Web-app admin login (the dashboard, NOT Instagram).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# JWT signing secret. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Database URL (SQLite by default — file lives under ./data/app.db)
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Default rate limits & schedule (per IG account)
DEFAULT_LIKES_PER_ACCOUNT=3
DEFAULT_MIN_DELAY_SECONDS=30
DEFAULT_MAX_DELAY_SECONDS=90
DEFAULT_DAILY_LIKE_LIMIT=100
DEFAULT_HOURLY_LIKE_LIMIT=20
DEFAULT_SCHEDULE_INTERVAL_HOURS=6

DEBUG=false
